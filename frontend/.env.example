# ── AI (OpenRouter) ──────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Embeddings (OpenAI — used by ChromaDB client for text-embedding-3-small)
# Get your key at https://platform.openai.com/api-keys
# Optional: if not set, ChromaDB embedding step is skipped gracefully
OPENAI_API_KEY=your_openai_key_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Run locally:  docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nlsql

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Run locally:  pip install chromadb && chroma run --path ./chroma-data --port 8001
# Optional: if not reachable, embedding storage is skipped gracefully
CHROMA_URL=http://localhost:8001
